SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key


GEMINI_API_KEY=your-gemini-api-key

ICP_FITMENT_MODEL=gemini-3.5-flash
ICP_FITMENT_CONCURRENCY=10
ICP_FITMENT_BATCH_SIZE=100
ICP_FITMENT_MAX_RETRIES=3
ICP_FITMENT_RETRY_DELAY=1
# Frontend origins allowed by CORS (comma separated)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Default model for every agent; override per agent with
# <AGENT>_MODEL, e.g. RESEARCH_MODEL / STRATEGY_MODEL.
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Retrieval
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35

# Outreach delivery. Real sends need provider credentials and the
# matching adapter in core/channels.py; until then messages are
# recorded but not delivered.
CHANNEL_SIMULATION=true
CHANNEL_EMAIL_ENABLED=false
CHANNEL_LINKEDIN_ENABLED=false
CHANNEL_SMS_ENABLED=false
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
